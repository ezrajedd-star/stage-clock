rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_.-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidDriver(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 300
        && data.carNumber is string && data.carNumber.size() > 0 && data.carNumber.size() <= 100
        && data.class is string && data.class.size() > 0 && data.class.size() <= 200
        && data.stageTimes is map
        && data.stagePenalties is map
        && data.totalTimeSeconds is number && data.totalTimeSeconds >= -2
        && data.updatedAt == request.time;
    }

    function isValidSettings(data) {
      return data.dnfPenalty is number && data.dnfPenalty >= 0;
    }

    match /drivers/{driverId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(driverId) && isValidDriver(incoming())
        && (!('isHidden' in incoming()) || incoming().isHidden is bool);
      allow update: if isSignedIn() && isValidId(driverId)
        && (
          // Action: Normal update from console
          (isValidDriver(incoming()) && incoming().carNumber == existing().carNumber) ||
          // Action: Toggle visibility (merge update)
          (incoming().diff(existing()).affectedKeys().hasOnly(['isHidden', 'updatedAt']) && incoming().updatedAt == request.time)
        );
      allow delete: if isSignedIn() && isValidId(driverId);
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(settingId) && isValidSettings(incoming());
    }
  }
}
