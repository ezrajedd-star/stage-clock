rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Admin: can enter times and manage the operator list.
    function isAdmin() {
      return isSignedIn() && request.auth.token.email.lower() == 'ezrajedd@gmail.com';
    }

    // Operator: the admin, or a timing staff member listed in /operators/{email}
    // (document ID = the staff member's Google account email, lowercase).
    function isOperator() {
      return isAdmin() || (isSignedIn()
        && exists(/databases/$(database)/documents/operators/$(request.auth.token.email.lower())));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_.-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidDriver(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 300
        && data.carNumber is string && data.carNumber.size() > 0 && data.carNumber.size() <= 100
        && data.class is string && data.class.size() > 0 && data.class.size() <= 200
        && data.stageTimes is map
        && data.stagePenalties is map
        && data.totalTimeSeconds is number && data.totalTimeSeconds >= -2
        && data.updatedAt == request.time;
    }

    function isValidSettings(data) {
      return data.dnfPenalty is number && data.dnfPenalty >= 0;
    }

    match /drivers/{driverId} {
      allow read: if true;
      allow create: if isOperator() && isValidId(driverId) && isValidDriver(incoming())
        && (!('isHidden' in incoming()) || incoming().isHidden is bool);
      allow update: if isOperator() && isValidId(driverId)
        && (
          // Action: Normal update from console
          (isValidDriver(incoming()) && incoming().carNumber == existing().carNumber) ||
          // Action: Toggle visibility (merge update)
          (incoming().diff(existing()).affectedKeys().hasOnly(['isHidden', 'updatedAt']) && incoming().updatedAt == request.time)
        );
      allow delete: if isOperator() && isValidId(driverId);
    }

    match /operators/{email} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.token.email.lower() == email);
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isOperator() && isValidId(settingId) && isValidSettings(incoming());
    }
  }
}
