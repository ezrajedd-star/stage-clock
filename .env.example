# Server-side only. Used by the Stage Report Writer (api/stage-report.ts).
# On Vercel: Project → Settings → Environment Variables. Never commit a real key.
ANTHROPIC_API_KEY=

# The Firebase web config lives in firebase-applet-config.json (public by design;
# Firestore access is controlled by firestore.rules).

# Server-side only. Used by "Close leg & publish" (api/close-leg.ts) to start the PARX Open
# results import on GitHub. Fine-grained token, PARX Open repository only, Contents: read and write.
PARX_GITHUB_TOKEN=
# Optional, defaults to ezrajedd-star/PARX-Open-MVP-Website
PARX_GITHUB_REPO=

# Browser. PARX Open website URL (for the leg list and the "View on PARX Open" link), no trailing slash.
VITE_PARX_SITE_URL=
