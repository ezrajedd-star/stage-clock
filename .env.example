# Firebase web app config (from Firebase console → Project settings → Your apps).
# Copy this file to .env.local and fill in the values. Never commit .env.local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# Optional, not currently used by the app (kept from the AI Studio template).
GEMINI_API_KEY=
